# Copy this file to .env and fill in your values for local development.
# .env is git-ignored and must never be committed.
# In Cloud Run these are injected as environment variables via Secret Manager.
#
# GCP credentials (Firestore, etc.) are NOT set here.
# For local dev, authenticate once with:
#   gcloud auth application-default login
# Cloud Run provides credentials automatically via the instance service account.

# Google Cloud project ID (used for Firestore client)
PROJECT_ID=your-gcp-project-id

# Gemini API key from Google AI Studio
GEMINI_API_KEY=your-gemini-api-key

# Secret PIN for upgrading a citizen account to an official account
MASTER_PIN=HERO-2026

# OAuth 2.0 Client ID from Google Cloud Console (used to validate JWT audience)
GOOGLE_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
